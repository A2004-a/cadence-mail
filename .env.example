# Cadence Server Configuration
PORT=4280
# Pin desktop EXE to the exact PORT above (prevents dynamic port fallback for fixed OAuth callbacks):
# CADENCE_EXPLICIT_PORT=1
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:4280
NODE_ENV=development

# Encryption key for stored credentials & OAuth tokens (32-byte hex or arbitrary passphrase; auto-generated locally if omitted in dev)
# CADENCE_ENCRYPTION_KEY=

# Google / Gmail OAuth 2.0 (Optional - enables Gmail REST API & OAuth login)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4280/api/v1/accounts/oauth/gmail/callback

# Microsoft 365 / Outlook OAuth 2.0 (Optional - enables Microsoft Graph API & OAuth login)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# MICROSOFT_REDIRECT_URI=http://localhost:4280/api/v1/accounts/oauth/outlook/callback

# Optional AI Provider Keys (Server-side only; never exposed to client)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Mode A: Independent Email Service & SMTP Infrastructure
# First registered user is admin unless CADENCE_ADMIN_EMAIL is explicitly set
# CADENCE_ADMIN_EMAIL=admin@yourdomain.com
# CADENCE_SMTP_ENABLED=true
# CADENCE_SMTP_BIND=127.0.0.1
# CADENCE_SMTP_MX_PORT=2525
# CADENCE_SMTP_SUBMISSION_PORT=2587
# CADENCE_OUTBOUND_MX_PORT=25
# CADENCE_PUBLIC_HOSTNAME=mail.yourdomain.com
# CADENCE_TLS_CERT=/etc/cadence/certs/fullchain.pem
# CADENCE_TLS_KEY=/etc/cadence/certs/privkey.pem
# Optional outbound smart-host relay if your host blocks outbound TCP port 25:
# CADENCE_RELAY_HOST=
# CADENCE_RELAY_PORT=587
# CADENCE_RELAY_SECURE=false
# CADENCE_RELAY_USER=
# CADENCE_RELAY_PASS=
